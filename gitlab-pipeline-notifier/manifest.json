{
  "manifest_version": 3,
  "name": "GitLab Pipeline Sound Notifier",
  "version": "1.0",
  "permissions": ["activeTab", "scripting", "notifications"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://gitlab.id-sign.com/*"],
      "js": ["content.js"]
    }
  ]
}
